# Raider 이미지 레지스트리 주소와 버전.
RAIDER_IMAGE=ghcr.io/astrataraxia/raider:1.3.8

# 호스트에서 접근할 주소와 포트. 외부 공개 시 주소를 0.0.0.0으로 변경하세요.
RAIDER_BIND_ADDRESS=127.0.0.1
RAIDER_PORT=8080

# 공용 즐겨찾기 SQLite를 저장할 서버 호스트 디렉터리.
RAIDER_DATA_PATH=./data

# 네이버 치지직 OpenAPI Client ID.
RAIDER__CHZZK__CLIENTID=your_chzzk_client_id_here

# 네이버 치지직 OpenAPI Client Secret.
RAIDER__CHZZK__CLIENTSECRET=your_chzzk_client_secret_here

# SOOP Developers에서 발급한 공식 API Client ID.
RAIDER__SOOP__CLIENTID=your_soop_client_id_here
