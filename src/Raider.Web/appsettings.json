{
  "Raider": {
    "Favorites": {
      "DatabasePath": "data/raider.db"
    },
    "Collection": {
      "Chzzk": {
        "Enabled": true,
        "PollInterval": "00:10:00",
        "CollectionTimeout": "00:03:00",
        "RetryMinimumDelay": "00:00:01",
        "RetryMaximumDelay": "00:00:03"
      },
      "Soop": {
        "Enabled": true,
        "PollInterval": "00:10:00",
        "CollectionTimeout": "00:03:00",
        "RetryMinimumDelay": "00:00:01",
        "RetryMaximumDelay": "00:00:03"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*"
}
