@* 새로고침마다 뽑은 즐겨찾기 라이브 가운데 큰 카드와 작은 카드 넷을 보여 준다. *@
@model System.Collections.Immutable.ImmutableArray<Raider.Web.Pages.FeaturedPick>
@{
    var multiple = Model.Length >= 2;
    var controlsHidden = multiple ? null : "hidden";
    var mosaic = Model.Length >= 5 ? "is-mosaic" : null;
}
<section data-featured>
    <div class="featured-label">
        <span>TODAY'S PICK</span>
        <span class="sub-label">새로고침마다 고른 즐겨찾기 라이브</span>
        <span class="label-rule" aria-hidden="true"></span>
        <div class="carousel-controls" data-featured-controls hidden="@controlsHidden">
            <button type="button" data-step="-1" aria-label="이전 즐겨찾기">‹</button>
            <span class="slide-count" data-featured-count>1 / @Model.Length</span>
            <button type="button" data-step="1" aria-label="다음 즐겨찾기">›</button>
        </div>
    </div>
    <div class="featured-deck @mosaic" data-featured-slides data-count="@Model.Length">
        @for (var index = 0; index < Model.Length; index++)
        {
            var pick = Model[index];
            var slot = mosaic is not null && index < 5 ? index.ToString() : null;
            <article class="featured-card @(index == 0 ? "is-front" : null)"
                     data-slot="@slot"
                     data-featured-slide
                     data-platform="@pick.Platform"
                     data-platform-label="@pick.PlatformLabel"
                     data-channel-id="@pick.ChannelId"
                     data-name="@pick.StreamerName"
                     data-title="@pick.Title"
                     data-viewers="@pick.ViewerCount.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                     data-watch="@pick.WatchUrl"
                     data-thumb="@pick.ThumbnailUrl"
                     data-line="@pick.Line"
                     data-tags="@string.Join('\u001f', pick.Tags)">
                <a class="featured-face" href="@pick.WatchUrl" target="_blank" rel="noopener noreferrer" aria-current="@(index == 0 ? "true" : null)" aria-label="@($"{pick.StreamerName} 방송 바로 보기")">
                    <span class="featured-media">
                        @if (!string.IsNullOrWhiteSpace(pick.ThumbnailUrl))
                        {
                            <img class="featured-photo" src="@pick.ThumbnailUrl" alt="" />
                        }
                        else
                        {
                            <span class="featured-fallback"></span>
                        }
                        <span class="featured-badges">
                            <span class="live-pill">LIVE</span>
                            <span class="featured-viewers">@pick.ViewerCount.ToString("N0")명</span>
                        </span>
                        <span class="featured-caption">
                            <span class="featured-platform platform-@pick.Platform">@pick.PlatformLabel</span>
                            <strong>@pick.StreamerName</strong>
                        </span>
                    </span>
                </a>
            </article>
        }
    </div>
    <span hidden data-featured-slides-end></span>
</section>
