@* 현재 라이브 방송을 필터링 가능한 타일 화면으로 표시한다. *@
@page
@model Raider.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Raider - Live Radar";
}
<!doctype html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="/css/site.css" asp-append-version="true" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=1.3.7" />
    <link rel="shortcut icon" type="image/svg+xml" href="/favicon.svg?v=1.3.7" />
</head>
<body>
    <div class="visually-hidden" data-antiforgery-token>@Html.AntiForgeryToken()</div>
    <header class="site-header">
        <div class="header-inner">
            <div class="brand-block">
                <a class="brand" asp-page="/Index" aria-label="Raider 홈">
                    <span class="brand-mark" aria-hidden="true"></span><span>Raider</span>
                </a>
                <span class="stream-count"><strong>@Model.TotalResultCount.ToString("N0")</strong>개 방송 중</span>
            </div>
            <div class="sync-state">
                @if (Model.IsRefreshing)
                {
                    <span class="refresh-spinner" title="수집 진행 중"></span>
                    <span class="sync-copy"><strong>수집 진행 중</strong><span>새 방송을 확인하고 있습니다...</span></span>
                }
                else
                {
                    <form method="post" asp-page-handler="Refresh" data-refresh-form>
                        @if (!string.IsNullOrWhiteSpace(Model.Platform)) { <input type="hidden" name="platform" value="@Model.Platform" /> }
                        @if (!string.IsNullOrWhiteSpace(Model.Tag)) { <input type="hidden" name="tag" value="@Model.Tag" /> }
                        @if (!string.IsNullOrWhiteSpace(Model.Query)) { <input type="hidden" name="q" value="@Model.Query" /> }
                        @if (Model.FavoritesOnly) { <input type="hidden" name="fav" value="true" /> }
                        @if (!string.IsNullOrWhiteSpace(Model.SelectedCategory)) { <input type="hidden" name="cat" value="@Model.SelectedCategory" /> }
                        <button type="submit" class="refresh-button" title="즉시 새로고침" aria-label="새로고침">
                            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                                <path d="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"/>
                            </svg>
                        </button>
                    </form>
                    <span class="status-dot @(Model.HasPartialFailure || Model.HasInitialFailure || Model.IsStale ? "is-warning" : "")" aria-hidden="true"></span>
                    <span class="sync-copy"><strong>@(Model.HasPartialFailure || Model.HasInitialFailure ? "일부 수집 지연" : "현재 스냅샷")</strong><span>@Model.SnapshotObservedAtText 갱신</span></span>
                }
            </div>
        </div>
    </header>

    <button type="button" class="favorites-mobile-toggle" aria-label="즐겨찾기 열기" aria-expanded="false" aria-controls="favorites-sidebar">즐겨찾기</button>
    <button type="button" class="favorites-backdrop" aria-label="즐겨찾기 배경 닫기"></button>
    <div class="app-layout">
    <aside class="favorites-sidebar" id="favorites-sidebar" aria-label="즐겨찾기 방송인">
        <div class="favorites-heading">
            <strong>즐겨찾기</strong>
            <div class="favorites-heading-actions" style="display: flex; gap: 4px;">
                <button type="button" class="favorites-add-category" title="새 카테고리 추가" aria-label="새 카테고리 추가">➕</button>
                <button type="button" class="favorites-collapse" aria-label="즐겨찾기 접기" aria-expanded="true" aria-controls="favorites-list">‹</button>
            </div>
        </div>
        <p class="favorites-status" role="status">불러오는 중...</p>
        <div class="favorites-list" id="favorites-list"></div>
    </aside>
    <main class="page-shell">
        <section class="hero" aria-labelledby="page-title">
            <div><p class="eyebrow">LIVE RADAR</p><h1 id="page-title">지금 볼 방송을 찾아보세요.</h1><p class="hero-description">CHZZK과 SOOP의 현재 라이브를 한곳에 모았습니다.</p></div>
            <div class="hero-stats" aria-label="현재 방송 통계"><div><span>검색 결과</span><strong>@Model.TotalResultCount.ToString("N0")</strong></div><div><span>총 시청자</span><strong>@Model.TotalViewers.ToString("N0")</strong></div></div>
        </section>

        <section class="controls" aria-label="방송 필터와 검색" data-selected-tag="@Model.Tag">
            <div class="controls-top">
                <nav class="platform-filter" aria-label="플랫폼 필터">
                    <a class="filter-button @(Model.SelectedPlatform is null && !Model.FavoritesOnly ? "is-active" : "")" asp-page="/Index" asp-route-tag="@Model.Tag" asp-route-q="@Model.Query">전체</a>
                    <a class="filter-button @(Model.SelectedPlatform == Raider.Web.Live.Platform.Chzzk ? "is-active" : "")" asp-page="/Index" asp-route-platform="chzzk" asp-route-tag="@Model.Tag" asp-route-q="@Model.Query" asp-route-fav="@(Model.FavoritesOnly ? "true" : "")" asp-route-cat="@Model.SelectedCategory"><span class="platform-dot chzzk-dot" aria-hidden="true"></span>CHZZK</a>
                    <a class="filter-button @(Model.SelectedPlatform == Raider.Web.Live.Platform.Soop ? "is-active" : "")" asp-page="/Index" asp-route-platform="soop" asp-route-tag="@Model.Tag" asp-route-q="@Model.Query" asp-route-fav="@(Model.FavoritesOnly ? "true" : "")" asp-route-cat="@Model.SelectedCategory"><span class="platform-dot soop-dot" aria-hidden="true"></span>SOOP</a>
                    <a class="filter-button @(Model.FavoritesOnly ? "is-active" : "")" asp-page="/Index" asp-route-platform="@Model.Platform" asp-route-tag="@Model.Tag" asp-route-q="@Model.Query" asp-route-fav="@(Model.FavoritesOnly ? "" : "true")" asp-route-cat=""><span class="platform-dot fav-dot" aria-hidden="true"></span>즐겨찾기</a>
                </nav>
                <form class="search-box" method="get">
                    @if (!string.IsNullOrWhiteSpace(Model.Platform)) { <input type="hidden" name="platform" value="@Model.Platform" /> }
                    @if (!string.IsNullOrWhiteSpace(Model.Tag)) { <input type="hidden" name="tag" value="@Model.Tag" /> }
                    @if (Model.FavoritesOnly) { <input type="hidden" name="fav" value="true" /> }
                    @if (!string.IsNullOrWhiteSpace(Model.SelectedCategory)) { <input type="hidden" name="cat" value="@Model.SelectedCategory" /> }
                    <span aria-hidden="true">⌕</span>
                    <label class="visually-hidden" for="stream-search">방송인, 제목 또는 태그 검색</label>
                    <input id="stream-search" name="q" type="search" value="@Model.Query" placeholder="방송인, 제목 또는 태그 검색" autocomplete="off" />
                    <button type="submit">검색</button>
                </form>
            </div>

            <div class="controls-tags">
                <span class="tags-label">추천 태그:</span>
                <div class="tag-filter" aria-label="인기 태그">
                    <a class="tag-button @(string.IsNullOrWhiteSpace(Model.Tag) ? "is-active" : "")" asp-page="/Index" asp-route-platform="@Model.Platform" asp-route-q="@Model.Query" asp-route-fav="@(Model.FavoritesOnly ? "true" : "")" asp-route-cat="@Model.SelectedCategory">모든 태그</a>
                    @foreach (var tag in Model.PopularTags)
                    {
                        var isActive = string.Equals(Model.Tag, tag, StringComparison.OrdinalIgnoreCase);
                        <a class="tag-button @(isActive ? "is-active" : "")" asp-page="/Index" asp-route-platform="@Model.Platform" asp-route-tag="@(isActive ? "" : tag)" asp-route-q="@Model.Query" asp-route-fav="@(Model.FavoritesOnly ? "true" : "")" asp-route-cat="@Model.SelectedCategory">@tag</a>
                    }
                    @if (Model.AllPopularTags.Length > Model.PopularTags.Length)
                    {
                        <button type="button" class="tag-drawer-toggle" id="tag-toggle-btn" aria-expanded="false" aria-controls="tag-drawer">태그 더 보기 +</button>
                    }
                </div>
            </div>

            @if (Model.AllPopularTags.Length > Model.PopularTags.Length)
            {
                <div class="tag-drawer" id="tag-drawer" style="display: none;">
                    <div class="tag-drawer-inner">
                        @foreach (var tag in Model.AllPopularTags)
                        {
                            var isActive = string.Equals(Model.Tag, tag, StringComparison.OrdinalIgnoreCase);
                            <a class="tag-button @(isActive ? "is-active" : "")" asp-page="/Index" asp-route-platform="@Model.Platform" asp-route-tag="@(isActive ? "" : tag)" asp-route-q="@Model.Query" asp-route-fav="@(Model.FavoritesOnly ? "true" : "")" asp-route-cat="@Model.SelectedCategory">@tag</a>
                        }
                    </div>
                </div>
            }

            @if (Model.FavoritesOnly && Model.FavoriteCategories.Length > 0)
            {
                <div class="controls-tags" style="margin-top: 8px;">
                    <span class="tags-label">카테고리 필터:</span>
                    <div class="tag-filter" aria-label="즐겨찾기 카테고리">
                        <a class="tag-button @(string.IsNullOrWhiteSpace(Model.SelectedCategory) ? "is-active" : "")" asp-page="/Index" asp-route-platform="@Model.Platform" asp-route-tag="@Model.Tag" asp-route-q="@Model.Query" asp-route-fav="true">전체 카테고리</a>
                        @foreach (var cat in Model.FavoriteCategories)
                        {
                            var isActive = string.Equals(Model.SelectedCategory, cat, StringComparison.OrdinalIgnoreCase);
                            <a class="tag-button @(isActive ? "is-active" : "")" asp-page="/Index" asp-route-platform="@Model.Platform" asp-route-tag="@Model.Tag" asp-route-q="@Model.Query" asp-route-fav="true" asp-route-cat="@(isActive ? "" : cat)">@cat</a>
                        }
                    </div>
                </div>
            }

            @if (Model.SelectedPlatform is not null || !string.IsNullOrWhiteSpace(Model.Tag) || !string.IsNullOrWhiteSpace(Model.Query) || Model.FavoritesOnly || !string.IsNullOrWhiteSpace(Model.SelectedCategory))
            {
                <div class="active-filters" aria-label="적용된 필터">
                    <span class="active-filters-label">적용된 필터:</span>
                    @if (Model.SelectedPlatform == Raider.Web.Live.Platform.Chzzk)
                    {
                        <a class="filter-chip chzzk" asp-page="/Index" asp-route-tag="@Model.Tag" asp-route-q="@Model.Query" asp-route-fav="@(Model.FavoritesOnly ? "true" : "")" asp-route-cat="@Model.SelectedCategory" aria-label="치지직 플랫폼 필터 해제">플랫폼: CHZZK <span class="chip-close">×</span></a>
                    }
                    @if (Model.SelectedPlatform == Raider.Web.Live.Platform.Soop)
                    {
                        <a class="filter-chip soop" asp-page="/Index" asp-route-tag="@Model.Tag" asp-route-q="@Model.Query" asp-route-fav="@(Model.FavoritesOnly ? "true" : "")" asp-route-cat="@Model.SelectedCategory" aria-label="숲 플랫폼 필터 해제">플랫폼: SOOP <span class="chip-close">×</span></a>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Tag))
                    {
                        <a class="filter-chip tag" asp-page="/Index" asp-route-platform="@Model.Platform" asp-route-q="@Model.Query" asp-route-fav="@(Model.FavoritesOnly ? "true" : "")" asp-route-cat="@Model.SelectedCategory" aria-label="태그 필터 해제">태그: @Model.Tag <span class="chip-close">×</span></a>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Query))
                    {
                        <a class="filter-chip query" asp-page="/Index" asp-route-platform="@Model.Platform" asp-route-tag="@Model.Tag" asp-route-fav="@(Model.FavoritesOnly ? "true" : "")" asp-route-cat="@Model.SelectedCategory" aria-label="검색어 필터 해제">검색어: "@Model.Query" <span class="chip-close">×</span></a>
                    }
                    @if (Model.FavoritesOnly)
                    {
                        <a class="filter-chip fav" asp-page="/Index" asp-route-platform="@Model.Platform" asp-route-tag="@Model.Tag" asp-route-q="@Model.Query" asp-route-cat="" aria-label="즐겨찾기 필터 해제">즐겨찾기만 <span class="chip-close">×</span></a>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.SelectedCategory))
                    {
                        <a class="filter-chip category" asp-page="/Index" asp-route-platform="@Model.Platform" asp-route-tag="@Model.Tag" asp-route-q="@Model.Query" asp-route-fav="true" asp-route-cat="" aria-label="카테고리 필터 해제">카테고리: @Model.SelectedCategory <span class="chip-close">×</span></a>
                    }
                    <a class="filter-clear-all" asp-page="/Index" aria-label="모든 필터 초기화">초기화</a>
                </div>
            }
        </section>

        <div data-live-content data-refreshing="@Model.IsRefreshing.ToString().ToLowerInvariant()" data-snapshot-version="@Model.Snapshot.Version.ToString(System.Globalization.CultureInfo.InvariantCulture)">
            @if (Model.HasPartialFailure)
            {
                <aside class="notice-banner" role="status"><strong>일부 플랫폼 갱신이 지연되고 있습니다.</strong><span>마지막 정상 목록을 표시하며 자동으로 재시도 중입니다.</span></aside>
            }
            @if (Model.IsStale)
            {
                <aside class="notice-banner" role="status"><strong>방송 목록이 오래되었습니다.</strong><span>플랫폼 갱신을 기다리고 있습니다.</span></aside>
            }

            <section class="section-heading" aria-labelledby="live-title"><div><p class="eyebrow">SORTED BY VIEWERS</p><h2 id="live-title">현재 인기 방송</h2></div><span>시청자 수 높은 순</span></section>

            @if (Model.IsInitialCollection)
            {
                <section class="state-panel"><h2>첫 방송 목록을 수집하고 있습니다.</h2><p>CHZZK과 SOOP의 현재 라이브를 확인하는 중입니다.</p><div class="skeleton-grid" aria-hidden="true">@for (var i = 0; i < 8; i++) { <span></span> }</div></section>
            }
            else if (Model.HasInitialFailure)
            {
                <section class="state-panel"><h2>첫 방송 목록을 가져오지 못했습니다.</h2><p>플랫폼 연결을 자동으로 재시도 중입니다.</p></section>
            }
            else if (Model.Streams.IsEmpty)
            {
                <section class="state-panel"><h2>현재 방송을 찾지 못했습니다.</h2><p>다른 플랫폼, 태그 또는 검색어를 사용해 보세요.</p></section>
            }
            else
            {
                <section class="stream-grid" aria-label="현재 라이브 방송">
                    @foreach (var stream in Model.Streams)
                    {
                        <partial name="_StreamTile" model="stream" />
                    }
                </section>
                @if (Model.TotalPages > 1)
                {
                    <nav class="pagination" aria-label="방송 목록 페이지">
                        @if (Model.PageNumber > 1)
                        {
                            <a href="@Url.Page("/Index", new { platform = Model.Platform, tag = Model.Tag, q = Model.Query, fav = Model.FavoritesOnly ? "true" : null, cat = Model.SelectedCategory, p = Model.PageNumber - 1 })">이전</a>
                        }
                        <span>@Model.PageNumber / @Model.TotalPages</span>
                        @if (Model.PageNumber < Model.TotalPages)
                        {
                            <a href="@Url.Page("/Index", new { platform = Model.Platform, tag = Model.Tag, q = Model.Query, fav = Model.FavoritesOnly ? "true" : null, cat = Model.SelectedCategory, p = Model.PageNumber + 1 })">다음</a>
                        }
                    </nav>
                }
            }
        </div>
    </main>
    </div>
    <script src="/js/favorites.js" asp-append-version="true"></script>
    <script src="/js/refresh.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            var toggleBtn = document.getElementById("tag-toggle-btn");
            var drawer = document.getElementById("tag-drawer");
            if (toggleBtn && drawer) {
                var isOpen = localStorage.getItem("tagDrawerOpen") === "true";
                if (isOpen) {
                    drawer.style.display = "block";
                    toggleBtn.setAttribute("aria-expanded", "true");
                    toggleBtn.textContent = "태그 접기 -";
                    toggleBtn.classList.add("is-open");
                }

                toggleBtn.addEventListener("click", function() {
                    var isExpanded = toggleBtn.getAttribute("aria-expanded") === "true";
                    isExpanded = !isExpanded;
                    toggleBtn.setAttribute("aria-expanded", isExpanded);
                    localStorage.setItem("tagDrawerOpen", isExpanded ? "true" : "false");
                    if (!isExpanded) {
                        drawer.style.display = "none";
                        toggleBtn.textContent = "태그 더 보기 +";
                        toggleBtn.classList.remove("is-open");
                    } else {
                        drawer.style.display = "block";
                        toggleBtn.textContent = "태그 접기 -";
                        toggleBtn.classList.add("is-open");
                    }
                });
            }
        });
    </script>
</body>
</html>
