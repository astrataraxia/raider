@page
@model Raider.Web.Pages.RecapModel
@{
    ViewData["Title"] = "채팅 리캡";
    var recap = Model.Recap;
    var bars = recap.Months.TakeLast(6).ToArray();
    var maxCount = bars.Length == 0 ? 1 : Math.Max(1, bars.Max(month => month.Count));
    var latest = bars.Length == 0 ? null : bars[^1];
    var previousMonth = latest?.Month.AddMonths(-1);
    var previous = previousMonth is null ? null : recap.Months.FirstOrDefault(month => month.Month == previousMonth);
    var header = new Raider.Web.Pages.SiteHeader("recap", null, false, false, false, null, null, Model.IsSignedIn, null, null, null, false, null);
}
<!doctype html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="/css/site.css" asp-append-version="true" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=1.3.8" />
</head>
<body>
    <div class="visually-hidden" data-antiforgery-token>@Html.AntiForgeryToken()</div>
    <partial name="_SiteHeader" model="header" />
    <main class="recap-page">
        <header class="page-intro">
            <p class="eyebrow">RECAP</p>
            <h1>나의 채팅 리캡</h1>
            @if (!string.IsNullOrWhiteSpace(Model.ViewerName))
            {
                <p>@Model.ViewerName</p>
            }
        </header>
        @if (!Model.IsSignedIn)
        {
            @if (Model.LoginFailed)
            {
                <p class="recap-note">치지직 로그인에 실패했습니다. 서버가 치지직 OpenAPI에 잠시 못 붙었을 수 있습니다. 다시 시도하세요.</p>
            }
            <p class="recap-note">채팅 건수는 SQLite에 남습니다. 로그인만 풀린 것이면 같은 계정으로 다시 들어오면 통계가 이어집니다.</p>
            <p><a class="recap-link" href="/auth/chzzk">치지직으로 로그인</a></p>
        }
        else if (Model.CollectionStartedOn is { } started)
        {
            <p class="recap-note">수집일: @started.ToString("yyyy-MM-dd")부터. 그 전 기록은 모으지 않았습니다. 감시하지 않는 채널은 세지 않습니다.</p>
        }
        else
        {
            <p class="recap-note">아직 모은 채팅이 없습니다. 치지직은 과거 채팅 목록을 주지 않습니다. Raider가 켜져 있는 동안, 홈 즐겨찾기의 CHZZK 채널이 라이브일 때 친 채팅만 앞으로 쌓입니다. 쌓인 건수는 SQLite에 남고, 로그인 쿠키와는 별개입니다.</p>
        }

        @if (recap.TotalChats > 0 && recap.HomeChannelId is not null)
        {
            <section class="recap-home-card">
                <div>
                    <p class="panel-kicker">본진</p>
                    <h2>@recap.HomeChannelName</h2>
                    <p>채팅 @recap.TotalChats.ToString("N0")건 중 @recap.Channels[0].Count.ToString("N0")건</p>
                </div>
                <div class="home-share">
                    <strong>@((recap.HomeShare * 100).ToString("0"))<span>%</span></strong>
                    <span>본진 비중</span>
                </div>
            </section>
            <section class="recap-stats">
                <div class="recap-card"><span>총 채팅</span><strong>@recap.TotalChats.ToString("N0")</strong></div>
                <div class="recap-card"><span>활동 채널</span><strong>@recap.ActiveChannels</strong></div>
                <div class="recap-card"><span>활동 일수</span><strong>@recap.ActiveDays</strong></div>
            </section>
            <div class="recap-two-col">
                <section class="recap-card streak-card">
                    <h2>최장 연속 출석</h2>
                    <p class="streak-number">@(recap.LongestStreak)<span>회</span></p>
                    <p>지금 @(recap.CurrentStreak)회 연속. 본진 방송이 있던 날 기준, 휴방은 건너뜁니다.</p>
                    @if (recap.RecentHomeDays.Length > 0)
                    {
                        <div class="week-dots" aria-label="최근 본진 방송일 출석">
                            @foreach (var attended in recap.RecentHomeDays)
                            {
                                <i class="@(attended ? "" : "off")"></i>
                            }
                        </div>
                    }
                </section>
                <section class="recap-card" aria-label="뱃지">
                    <h2>뱃지</h2>
                    <div class="badge-list">
                        @if (recap.HasAttendanceBadge)
                        {
                            <span>개근 @recap.HomeChannelName <b>출석률 @((recap.AttendanceRate * 100).ToString("0"))%</b></span>
                        }
                        @if (recap.HasVeteranBadge)
                        {
                            <span>고인물 @recap.HomeChannelName</span>
                        }
                        @if (recap.HasLoyaltyBadge)
                        {
                            <span>일편단심 <b>본진 비중 @((recap.HomeShare * 100).ToString("0"))%</b></span>
                        }
                        @if (recap.HasHopperBadge)
                        {
                            <span>메뚜기 <b>@(recap.ActiveChannels)개 채널</b></span>
                        }
                    </div>
                </section>
            </div>
            <div class="recap-two-col">
                <section class="recap-card">
                    <h2>채널</h2>
                    <table class="recap-table">
                        <thead>
                            <tr><th>채널</th><th>채팅</th><th>비중</th></tr>
                        </thead>
                        <tbody>
                        @foreach (var channel in recap.Channels)
                        {
                            var share = recap.TotalChats == 0 ? 0 : (double)channel.Count / recap.TotalChats;
                            <tr>
                                <td>@channel.Name</td>
                                <td>@channel.Count.ToString("N0")</td>
                                <td>@((share * 100).ToString("0"))%</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </section>
                <section class="recap-card">
                    <h2>월별 채팅 수</h2>
                    @if (latest is not null && previous is not null)
                    {
                        var delta = latest.Count - previous.Count;
                        <p class="month-delta">@(delta >= 0 ? $"지난달보다 {delta:N0}건 늘었습니다." : $"지난달보다 {Math.Abs(delta):N0}건 줄었습니다.")</p>
                    }
                    <div class="bar-chart" aria-label="최근 월별 채팅">
                        @foreach (var month in bars)
                        {
                            var height = Math.Max(8, (int)Math.Round(month.Count * 100.0 / maxCount));
                            <div class="bar-col">
                                <span class="bar" style="height: @(height)%"></span>
                                <span>@month.Month.ToString("yyyy-MM")</span>
                                <span>@month.Count.ToString("N0")건</span>
                            </div>
                        }
                    </div>
                </section>
            </div>
        }
    </main>
</body>
</html>
